# ---------------------------------------------------------------------------
# TechSara Placement League — environment configuration
# Copy to .env and adjust. Every value has a safe local default.
# ---------------------------------------------------------------------------

# HTTP port for the whole app (UI + API + WebSocket).
PORT=3000
# Bind address. Use 0.0.0.0 to let phones/projector PCs on the same Wi-Fi open the display.
HOST=0.0.0.0

# PostgreSQL connection string. Leave EMPTY to use the bundled embedded PostgreSQL
# (data in ./.data/postgres, no install or Docker needed).
DATABASE_URL=
# Port used by the embedded PostgreSQL when DATABASE_URL is empty.
EMBEDDED_PG_PORT=5433

# First organizer account, created on first start if no organizer exists yet.
# `npm run setup` fills in a random password. Left empty (or shorter than 10 characters),
# the server generates a random one on first start and prints it once.
# Later password changes: npm run create-admin -- admin <new password>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session lifetime for organizer logins (hours).
SESSION_TTL_HOURS=12

# Where uploaded team logos and candidate photos are stored.
UPLOAD_DIR=./storage/uploads

# Set to true only when the app is served over HTTPS (secure cookies).
COOKIE_SECURE=false
